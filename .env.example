# Public Expo/Firebase identifiers. Never commit private service-account keys.
EXPO_PUBLIC_EXPO_OWNER=
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Optional paths used by app.config.ts. The files themselves are gitignored.
GOOGLE_SERVICES_JSON=./firebase/android/google-services.json
GOOGLE_SERVICE_INFO_PLIST=./firebase/ios/GoogleService-Info.plist
